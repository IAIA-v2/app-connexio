[Unit]
Description=Iaia bridge (MQTT <-> OVOS)
After=network-online.target ovos-messagebus.service
Wants=network-online.target

[Service]
ExecStart=%h/.venvs/ovos/bin/python -u %h/iaia-bridge.py
StandardOutput=append:%h/.local/state/mycroft/iaia-bridge.log
StandardError=append:%h/.local/state/mycroft/iaia-bridge.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
